# ═══════════════════════════════════════════════════════════════
# Environment Variables — [PROJECT NAME]
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets.
# ═══════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
API_PREFIX=/api/v1

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/[project_db]
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication ──────────────────────────────────────────
JWT_SECRET=change-this-to-a-strong-random-string-min-256-bits
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── External Services (fill per project) ────────────────────
# PAYMENT_API_KEY=
# PAYMENT_SECRET_KEY=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# EMAIL_API_KEY=
# SMS_API_KEY=

# ── Monitoring (optional) ──────────────────────────────────
# SENTRY_DSN=
# LOG_LEVEL=debug

# ── Feature Flags (optional) ───────────────────────────────
# FEATURE_PAYMENTS=true
# FEATURE_ARABIC=true
