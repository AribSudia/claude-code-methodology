# ── Environment & Secrets ─────────────────────────────────
.env
.env.local
.env.production
.env.staging
*.env
*.pem
*.key
credentials.json
service-account.json

# ── Dependencies ─────────────────────────────────────────
node_modules/
vendor/
.venv/
__pycache__/
*.pyc

# ── Build Output ─────────────────────────────────────────
dist/
build/
out/
.next/
bin/
obj/
*.dll
*.exe

# ── IDE & OS ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────
*.log
logs/
npm-debug.log*

# ── Testing ──────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/

# ── Docker ───────────────────────────────────────────────
docker-compose.override.yml

# ── Temporary ────────────────────────────────────────────
tmp/
temp/
*.tmp

# ── Claude Code Local (personal, not shared) ────────────
.claude/settings.local.json
.claude/agent-memory-local/

# ── Memory Archives (keep in git, but ignore temp) ──────
memory/archive/*.tmp

# ── CCM Hook Artifacts ──────────────────────────────────
# High-volume hook logs — not committed.
io/hook-logs/
# Per-session marker file used by stop.sh to compute accurate diffs.
io/.session-start-sha
# NOTE: io/ledger/ is intentionally NOT ignored — it's the audit trail.
# Rotate old ledgers manually if they accumulate.

# Autonomy mode runtime state (Item #10) — ephemeral per-session counters.
io/.autonomy/

# Invocation telemetry + notification trace (high-volume, per-project runtime)
io/ledger/invocations.jsonl
io/ledger/.notifications.jsonl

# Claude Code worktrees (transient, never committed)
.claude/worktrees/
