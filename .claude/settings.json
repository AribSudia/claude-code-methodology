{
  "permissions": {
    "allow": [
      "Read:*",
      "Glob:*",
      "Grep:*",
      "Bash(git *)",
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(dotnet *)",
      "Bash(docker compose *)",
      "Bash(docker-compose *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(cp *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(chmod 777 *)",
      "Write:.env",
      "Write:.env.local",
      "Write:.env.production"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/invocation-log.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-tool-use.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": ".claude/hooks/autonomy-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/invocation-log.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/stop.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/notification.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "_context_note": "v3.8.0 Lean Core (ADR-019): always-on context is the minimum Claude must see BEFORE acting — master brain, hard rules, current state, last handoff. Everything else (TECH_STACK, CONTEXT_MAP, ERROR_PATTERNS, DECISIONS, SECURITY, API_ENDPOINTS, EVENT_SCHEMA, MIGRATION_ORDER, WORKFLOW) is read ON DEMAND by the skill/agent/hook that needs it — see CLAUDE.md section 6. This cut always-on cost ~45.9K -> ~8.3K (82%).",
  "context": {
    "include": [
      "CLAUDE.md",
      "architecture/CONSTRAINTS.md",
      "memory/project_status.md",
      "memory/session_notes.md"
    ]
  },
  "MAX_THINKING_TOKENS": 16000,
  "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
}
